@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix calli: <http://example.org/ontology/calligraphy#> .
@prefix map: <http://example.org/mapping#> .

# 定义逻辑数据源
map:LogicalSource a rml:LogicalSource ;
    rml:source "书法家三元组.csv" ;
    rml:referenceFormulation ql:CSV .

# 书法家实体映射 - 为每个唯一的书法家创建实体
map:CalligrapherMapping a rr:TriplesMap ;
    rml:logicalSource map:LogicalSource ;
    rr:subjectMap [
        rr:template "http://example.org/calligraphy/calligrapher/{主体}" ;
        rr:class calli:Calligrapher
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "主体" ; rr:datatype xsd:string ]
    ] .

# 所属朝代映射 - 只处理关系="所属朝代"的行
map:DynastyMapping a rr:TriplesMap ;
    rml:logicalSource [
        a rml:LogicalSource ;
        rml:source "书法家三元组.csv" ;
        rml:referenceFormulation ql:CSV ;
        rml:iterator "[关系='所属朝代']"
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/calligraphy/calligrapher/{主体}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate calli:dynasty ;
        rr:objectMap [ rml:reference "客体" ; rr:datatype xsd:string ]
    ] .

# 字号映射
map:StyleNameMapping a rr:TriplesMap ;
    rml:logicalSource [
        a rml:LogicalSource ;
        rml:source "书法家三元组.csv" ;
        rml:referenceFormulation ql:CSV ;
        rml:iterator "[关系='字号']"
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/calligraphy/calligrapher/{主体}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate calli:styleName ;
        rr:objectMap [ rml:reference "客体" ; rr:datatype xsd:string ]
    ] .

